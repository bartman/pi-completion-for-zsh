#compdef pi
# Generated by ~/.pi/completion-by-grok.py from `pi --help`.
# Refresh:
#   ~/.pi/completion-by-grok.py > ~/.cache/zsh/pi-completion-by-grok.zsh

_pi_tools() {
  _values -s , 'tool' \
    'read[Read file contents]' \
    'bash[Execute bash commands]' \
    'powershell[Execute PowerShell commands on Windows]' \
    'edit[Edit files with find/replace]' \
    'write[Write files (creates/overwrites)]' \
    'grep[Search file contents (read-only, off by default)]' \
    'find[Find files by glob pattern (read-only, off by default)]' \
    'ls[List directory contents (read-only, off by default)]'
}

_pi_atfiles() {
  [[ $PREFIX == @* ]] || return 1
  PREFIX=${PREFIX#@}
  _files -P @
}

_pi() {
  local curcontext="$curcontext" context state state_descr line ret=1
  typeset -A opt_args
  local -a commands
  commands=(
    'install:Install extension source and add to settings'
    'remove:Remove extension source from settings'
    'uninstall:Alias for remove'
    'update:Update pi, extensions, or model catalogs'
    'list:List installed extensions from settings'
    'config:Open TUI to enable/disable package resources (Tab switches scope)'
    'auth:Print credentials or check provider readiness'
    'mcp:Check MCP servers, sign in to or out of OAuth servers'
  )
  _arguments -S -C -A "-*" \
    '--provider[Provider to search for --model (requires --model)]:name:' \
    '--model[Model pattern or ID (supports "provider/id" and optional ":<thinking>")]:pattern:' \
    '--api-key[API key (defaults to env vars)]:key:' \
    '--system-prompt[System prompt (default: coding assistant prompt)]:text:' \
    '*--append-system-prompt[Append text or file contents to the system prompt (can be used multiple times)]:text:' \
    '--mode[Output mode]:mode:(text json rpc)' \
    '(-p --print)'{-p,--print}'[Non-interactive mode: process prompt and exit]' \
    '(-c --continue)'{-c,--continue}'[Continue previous session]' \
    '(-r --resume)'{-r,--resume}'[Select a session to resume]' \
    '--session[Use specific session file or partial UUID]:path|id:_files' \
    '--session-id[Use exact project session ID, creating it if missing]:id:' \
    '--fork[Fork specific session file or partial UUID into a new session]:path|id:_files' \
    '--session-dir[Directory for session storage and lookup]:dir:_files -/' \
    '--no-session[Don'\''t save session (ephemeral)]' \
    '(-n --name)'{-n,--name}'[Set session display name]:name:' \
    '--models[Comma-separated model patterns for Ctrl+P cycling Supports globs (anthropic/*, *sonnet*) and fuzzy matching]:patterns:' \
    '(-nt --no-tools)'{-nt,--no-tools}'[Disable all tools by default (built-in and extension)]' \
    '(-nbt --no-builtin-tools)'{-nbt,--no-builtin-tools}'[Disable built-in tools by default but keep extension/custom tools enabled]' \
    '(-t --tools)'{-t,--tools}'[Comma-separated allowlist of tool names or patterns (*) to enable Keeps MCP tools unless an entry starts with mcp__ Only +name/-name entries add to or remove from the defaults]:tools: _pi_tools' \
    '(-xt --exclude-tools)'{-xt,--exclude-tools}'[Comma-separated denylist of tool names or patterns (*) to disable Applies to all tools, MCP tools included]:tools: _pi_tools' \
    '--thinking[Set thinking level]:level:(off minimal low medium high xhigh max)' \
    '*'{-e,--extension}'[Load an extension file or builtin:<name> (can be used multiple times)]:path:_files' \
    '(-ne --no-extensions)'{-ne,--no-extensions}'[Disable extension discovery and built-in extensions (explicit -e paths still work)]' \
    '--no-mcp[Disable built-in MCP support: no servers connect and no MCP tools]' \
    '*--skill[Load a skill file or directory (can be used multiple times)]:path:_files' \
    '(-ns --no-skills)'{-ns,--no-skills}'[Disable skills discovery and loading]' \
    '*--prompt-template[Load a prompt template file or directory (can be used multiple times)]:path:_files' \
    '(-np --no-prompt-templates)'{-np,--no-prompt-templates}'[Disable prompt template discovery and loading]' \
    '*--theme[Load a theme file or directory (can be used multiple times)]:path:_files' \
    '--use-theme[Set the initial interactive theme for this run]:name:' \
    '--no-themes[Disable theme discovery and loading]' \
    '(-nc --no-context-files)'{-nc,--no-context-files}'[Disable AGENTS.md and CLAUDE.md discovery and loading]' \
    '--export[Export session file to HTML and exit]:file:_files' \
    '--list-models[List available models (with optional fuzzy search)]::search:' \
    '--verbose[Force verbose startup (overrides quietStartup setting)]' \
    '--tui-mode[TUI mode]:mode:(fullscreen regular)' \
    '(-a --approve)'{-a,--approve}'[Trust project-local files for this run]' \
    '(-na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this run]' \
    '--offline[Disable startup network operations (same as PI_OFFLINE=1)]' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    '(-v --version)'{-v,--version}'[Show version number]' \
    '1: :->cmd' \
    '*:: :->args' && ret=0
  case $state in
    (cmd)
      _describe -t commands 'command' commands && ret=0
      _pi_atfiles && ret=0
      ;;
    (args)
      case $line[1] in
        (install) _pi_install && ret=0 ;;
        (remove) _pi_remove && ret=0 ;;
        (uninstall) _pi_uninstall && ret=0 ;;
        (update) _pi_update && ret=0 ;;
        (list) _pi_list && ret=0 ;;
        (config) _pi_config && ret=0 ;;
        (auth) _pi_auth && ret=0 ;;
        (mcp) _pi_mcp && ret=0 ;;
        (*) _pi_atfiles && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

_pi_install() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '(-l --local)'{-l,--local}'[Install project-locally (.pi/settings.json)]' \
    '(-a --approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    ':source:_files'
}

_pi_remove() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '(-l --local)'{-l,--local}'[Remove from project settings (.pi/settings.json)]' \
    '(-a --approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    ':source:_files'
}

_pi_uninstall() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '(-l --local)'{-l,--local}'[Remove from project settings (.pi/settings.json)]' \
    '(-a --approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    ':source:_files'
}

_pi_update_1() {
  _alternative \
    'choices:source:(self pi)' \
    'files:source:_files'
}

_pi_update() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '--self[Update pi only (default when no target is given)]' \
    '--extensions[Update installed packages only]' \
    '--models[Refresh model catalogs only]' \
    '--all[Update pi and installed packages]' \
    '--extension[Update one package only]:source:_files' \
    '(-a --approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    '--force[Reinstall pi even if the current version is latest]' \
    '::source: _pi_update_1'
}

_pi_list() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '(-a --approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]'
}

_pi_config() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '(-l --local)'{-l,--local}'[Edit project overrides (.pi/settings.json)]' \
    '(-a --approve)'{-a,--approve}'[Trust project-local files for this command with -l]' \
    '(-na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command with -l]'
}

_pi_auth() {
  local curcontext="$curcontext" context state state_descr line ret=1
  typeset -A opt_args
  local -a commands
  commands=(
    'print-api-key'
    'print-bearer-token'
    'check'
  )
  _arguments -S -C -A "-*" \
    '1: :->cmd' \
    '*:: :->args' && ret=0
  case $state in
    (cmd)
      _describe -t commands 'command' commands && ret=0
      ;;
    (args)
      case $line[1] in
        (print-api-key) _pi_auth_print_api_key && ret=0 ;;
        (print-bearer-token) _pi_auth_print_bearer_token && ret=0 ;;
        (check) _pi_auth_check && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

_pi_auth_print_api_key() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '--provider[Auth commands require at least one of --provider or --model]:provider:' \
    '--model[Auth commands require at least one of --provider or --model]:model:'
}

_pi_auth_print_bearer_token() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '--provider[Auth commands require at least one of --provider or --model]:provider:' \
    '--model[Auth commands require at least one of --provider or --model]:model:' \
    '--min-expiry:duration:'
}

_pi_auth_check() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '--provider[Auth commands require at least one of --provider or --model]:provider:' \
    '--model[Auth commands require at least one of --provider or --model]:model:' \
    '--json' \
    '--credentials[--credentials emits the credential, or includes it in JSON output]' \
    '--no-refresh[Checks refresh expired OAuth credentials by default; --no-refresh prevents this]'
}

_pi_mcp() {
  local curcontext="$curcontext" context state state_descr line ret=1
  typeset -A opt_args
  local -a commands
  commands=(
    'add:Add or replace a server in mcp.json'
    'remove:Remove a server from mcp.json'
    'list:Show state, tools, and errors (exits 1 on failure)'
    'login:Sign in through the browser'
    'logout:Delete the stored OAuth credentials'
  )
  _arguments -S -C -A "-*" \
    '1: :->cmd' \
    '*:: :->args' && ret=0
  case $state in
    (cmd)
      _describe -t commands 'command' commands && ret=0
      ;;
    (args)
      case $line[1] in
        (add) _pi_mcp_add && ret=0 ;;
        (remove) _pi_mcp_remove && ret=0 ;;
        (list) _pi_mcp_list && ret=0 ;;
        (login) _pi_mcp_login && ret=0 ;;
        (logout) _pi_mcp_logout && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

_pi_mcp_add() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '(-l --local)'{-l,--local}'[Use .pi/mcp.json in the current project instead of the global file]' \
    '--url[Streamable HTTP server URL (instead of a command)]:url:' \
    '*--env[Environment variable for a stdio server (repeatable)]:KEY=VALUE:' \
    '--cwd[Working directory for a stdio server]:dir:_files -/' \
    '*--header[HTTP header (repeatable)]:KEY=VALUE:' \
    '--bearer-token-env-var[Send "Authorization: Bearer ${NAME}"]:NAME:' \
    '--oauth-client-id[Pre-registered OAuth client id]:id:' \
    '--oauth-client-secret[OAuth client secret (may be ${NAME} or !command)]:secret:' \
    '--oauth-callback-port[Fixed OAuth callback port]:port:' \
    '--oauth-client-name[Client name sent when registering with the OAuth server]:name:' \
    '--exposure[codemode (default), deferred, direct, or hidden]:mode:(codemode deferred direct hidden)' \
    '--description[What the server offers, shown in the system prompt]:text:' \
    ':server:' \
    '*:command:_normal'
}

_pi_mcp_remove() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '(-l --local)'{-l,--local}'[Use .pi/mcp.json in the current project instead of the global file]' \
    ':server:'
}

_pi_mcp_list() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '--json[Print the list as JSON]'
}

_pi_mcp_login() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    '--timeout[How long login waits for the browser (default: 300)]:seconds:' \
    ':server:'
}

_pi_mcp_logout() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -S \
    ':server:'
}

compdef _pi pi
