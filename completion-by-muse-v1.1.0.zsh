#compdef pi
# Generated by ~/proj/pi-completion-for-zsh/./completion-by-muse.py from `pi --help` and subcommand help.
# /run/current-system/sw/bin/pi
# Refresh:
#   ~/proj/pi-completion-for-zsh/./completion-by-muse.py > ~/.cache/zsh/pi-completion-by-muse.zsh
# Do not edit by hand; edit the generator instead.

typeset -ga _pi_tool_names _pi_thinking_levels
_pi_tool_names=(
  'read:Read file contents'
  'bash:Execute bash commands'
  'powershell:Execute PowerShell commands on Windows'
  'edit:Edit files with find/replace'
  'write:Write files (creates/overwrites)'
  'grep:Search file contents (read-only, off by default)'
  'find:Find files by glob pattern (read-only, off by default)'
  'ls:List directory contents (read-only, off by default)'
)
_pi_thinking_levels=( off minimal low medium high xhigh max )

# --- runtime helpers --------------------------------------------------------

(( $+functions[_pi_real] )) || _pi_real() {
  # bypass any shell wrapper function named pi
  print -r -- "${commands[pi]:-pi}"
}

_pi_agent_dir() {
  print -r -- "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
}

_pi_load_models() {
  (( ${#_pi_model_cache} )) && return
  local -a rows
  rows=( ${(f)"$(PI_OFFLINE=1 "$(_pi_real)" --offline --list-models 2>/dev/null)"} )
  typeset -ga _pi_model_cache _pi_provider_cache
  local row
  for row in ${rows[2,-1]}; do
    local -a f=( ${=row} )
    (( ${#f} >= 2 )) || continue
    _pi_model_cache+=( "$f[1]/$f[2]" )
    _pi_provider_cache+=( "$f[1]" )
  done
  _pi_provider_cache=( ${(u)_pi_provider_cache} )
}

_pi_providers() {
  _pi_load_models
  _describe -t providers 'provider' _pi_provider_cache
}

_pi_models() {
  _pi_load_models
  if compset -P '*:'; then
    _describe -t thinking 'thinking level' _pi_thinking_levels
    return
  fi
  local provider=${opt_args[--provider]}
  local -a models
  if [[ -n $provider ]]; then
    models=( ${${(M)_pi_model_cache:#$provider/*}#$provider/} )
  else
    models=( $_pi_model_cache )
  fi
  _multi_parts -q / models
}

_pi_model_list() {
  _pi_load_models
  compset -P '*,'
  _multi_parts -q -S , / _pi_model_cache
}

_pi_tools() {
  compset -P '*,'
  compset -P '[+-]'
  _describe -t tools 'tool' _pi_tool_names -qS ,
}

_pi_themes() {
  local -a themes
  themes=( dark light )
  themes+=( $(_pi_agent_dir)/themes/*.json(N:t:r) .pi/themes/*.json(N:t:r) )
  _describe -t themes 'theme' themes
}

_pi_sessions() {
  _files -g '*.jsonl(-.)'
}

_pi_packages() {
  local -a pkgs
  pkgs=( ${${(M)${(f)"$("$(_pi_real)" list 2>/dev/null)"}:#  [^ ]*}##  } )
  pkgs=( ${pkgs//:/\\:} )
  _describe -t packages 'installed package' pkgs
}

_pi_install_sources() {
  _alternative \
    'schemes:source type:compadd -S "" npm: git: https:// ssh://' \
    'files:local path:_files -/'
}

_pi_mcp_servers() {
  local -a servers
  local f
  for f in "$(_pi_agent_dir)/mcp.json" .pi/mcp.json; do
    [[ -r $f ]] || continue
    servers+=( ${(f)"$(python3 -c 'import json,sys
try: print("\n".join(json.load(open(sys.argv[1])).get("mcpServers", {})))
except Exception: pass' $f 2>/dev/null)"} )
  done
  servers=( ${(u)servers} )
  _describe -t servers 'MCP server' servers
}

_pi_atfiles() {
  [[ $PREFIX == @* ]] || return 1
  compset -P @
  _files
}

# --- commands ----------------------------------------------------------------

_pi() {
  local curcontext="$curcontext" context state state_descr line ret=1
  typeset -A opt_args
  local -a subcmds
  subcmds=(
    'install:Install extension source and add to settings'
    'remove:Remove extension source from settings'
    'uninstall:Alias for remove'
    'update:Update pi, extensions, or model catalogs'
    'list:List installed extensions from settings'
    'config:Open TUI to enable/disable package resources (Tab switches scope)'
    'auth:Print credentials or check provider readiness'
    'mcp:Check MCP servers, sign in to or out of OAuth servers'
  )
  _arguments -S -C \
    '--provider[Provider to search for --model (requires --model)]:name:_pi_providers' \
    '--model[Model pattern or ID (supports "provider/id" and optional "\:<thinking>")]:pattern:_pi_models' \
    '--api-key[API key (defaults to env vars)]:key:' \
    '--system-prompt[System prompt (default\: coding assistant prompt)]:text:' \
    '*--append-system-prompt[Append text or file contents to the system prompt (can be used multiple times)]:text:' \
    '--mode[Output mode\: text (default), json, or rpc]:mode:(text json rpc)' \
    '(-p --print)'{-p,--print}'[Non-interactive mode\: process prompt and exit]' \
    '(-c --continue)'{-c,--continue}'[Continue previous session]' \
    '(-r --resume)'{-r,--resume}'[Select a session to resume]' \
    '--session[Use specific session file or partial UUID]:path|id:_pi_sessions' \
    '--session-id[Use exact project session ID, creating it if missing]:id:' \
    '--fork[Fork specific session file or partial UUID into a new session]:path|id:_pi_sessions' \
    '--session-dir[Directory for session storage and lookup]:dir:_files -/' \
    '--no-session[Don'\''t save session (ephemeral)]' \
    '(-n --name)'{-n,--name}'[Set session display name]:name:' \
    '--models[Comma-separated model patterns for Ctrl+P cycling Supports globs (anthropic/*, *sonnet*) and fuzzy matching]:patterns:_pi_model_list' \
    '(-nt --no-tools)'{-nt,--no-tools}'[Disable all tools by default (built-in and extension)]' \
    '(-nbt --no-builtin-tools)'{-nbt,--no-builtin-tools}'[Disable built-in tools by default but keep extension/custom tools enabled]' \
    '(-t --tools)'{-t,--tools}'[Comma-separated allowlist of tool names or patterns (*) to enable Keeps MCP tools unless an entry starts with mcp__ Only +name/-name entries add to or remove from the defaults]:tools:_pi_tools' \
    '(-xt --exclude-tools)'{-xt,--exclude-tools}'[Comma-separated denylist of tool names or patterns (*) to disable Applies to all tools, MCP tools included]:tools:_pi_tools' \
    '--thinking[Set thinking level\: off, minimal, low, medium, high, xhigh, max]:level:(off minimal low medium high xhigh max)' \
    '*'{-e,--extension}'[Load an extension file or builtin\:<name> (can be used multiple times)]:path:_files' \
    '(-ne --no-extensions)'{-ne,--no-extensions}'[Disable extension discovery and built-in extensions (explicit -e paths still work)]' \
    '--no-mcp[Disable built-in MCP support\: no servers connect and no MCP tools]' \
    '*--skill[Load a skill file or directory (can be used multiple times)]:path:_files' \
    '(-ns --no-skills)'{-ns,--no-skills}'[Disable skills discovery and loading]' \
    '*--prompt-template[Load a prompt template file or directory (can be used multiple times)]:path:_files' \
    '(-np --no-prompt-templates)'{-np,--no-prompt-templates}'[Disable prompt template discovery and loading]' \
    '*--theme[Load a theme file or directory (can be used multiple times)]:path:_files' \
    '--use-theme[Set the initial interactive theme for this run]:name[/name]:_pi_themes' \
    '--no-themes[Disable theme discovery and loading]' \
    '(-nc --no-context-files)'{-nc,--no-context-files}'[Disable AGENTS.md and CLAUDE.md discovery and loading]' \
    '--export[Export session file to HTML and exit]:file:_files' \
    '--list-models[List available models (with optional fuzzy search)]::search:' \
    '--verbose[Force verbose startup (overrides quietStartup setting)]' \
    '--tui-mode[TUI mode\: fullscreen (default) or regular]:mode:(fullscreen regular)' \
    '(-a --approve)'{-a,--approve}'[Trust project-local files for this run]' \
    '(-na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this run]' \
    '--offline[Disable startup network operations (same as PI_OFFLINE=1)]' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    '(-v --version)'{-v,--version}'[Show version number]' \
    '1: :->cmd' \
    '*:: :->args' && ret=0
  case $state in
    (cmd)
      _describe -t commands 'command' subcmds && ret=0
      _pi_atfiles && ret=0
      ;;
    (args)
      curcontext="${curcontext%:*:*}:pi-$line[1]:"
      case $line[1] in
        (install) _pi_install && ret=0 ;;
        (remove) _pi_remove && ret=0 ;;
        (uninstall) _pi_uninstall && ret=0 ;;
        (update) _pi_update && ret=0 ;;
        (list) _pi_list && ret=0 ;;
        (config) _pi_config && ret=0 ;;
        (auth) _pi_auth && ret=0 ;;
        (mcp) _pi_mcp && ret=0 ;;
        (*) _pi_atfiles && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

_pi_install() {
  _arguments -S \
    '(-l --local)'{-l,--local}'[Install project-locally (.pi/settings.json)]' \
    '(-a --approve --no-approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --approve --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    ':source:_pi_install_sources'
}

_pi_remove() {
  _arguments -S \
    '(-l --local)'{-l,--local}'[Remove from project settings (.pi/settings.json)]' \
    '(-a --approve --no-approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --approve --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    ':source:_pi_packages'
}

_pi_uninstall() {
  _arguments -S \
    '(-l --local)'{-l,--local}'[Remove from project settings (.pi/settings.json)]' \
    '(-a --approve --no-approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --approve --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    ':source:_pi_packages'
}

_pi_update_source() {
  _alternative \
    'keywords:source:(self pi)' \
    'values:source:_pi_packages'
}

_pi_update() {
  _arguments -S \
    '(--all --self --models --extensions)--self[Update pi only (default when no target is given)]' \
    '(--all --self --models --extensions)--extensions[Update installed packages only]' \
    '(--all --self --models --extensions)--models[Refresh model catalogs only]' \
    '(--all --self --models --extensions)--all[Update pi and installed packages]' \
    '--extension[Update one package only]:source:_pi_packages' \
    '(-a --approve --no-approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --approve --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    '--force[Reinstall pi even if the current version is latest]' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    '::source:_pi_update_source'
}

_pi_list() {
  _arguments -S \
    '(-a --approve --no-approve)'{-a,--approve}'[Trust project-local files for this command]' \
    '(-na --approve --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

_pi_config() {
  _arguments -S \
    '(-l --local)'{-l,--local}'[Edit project overrides (.pi/settings.json)]' \
    '(-a --approve --no-approve)'{-a,--approve}'[Trust project-local files for this command with -l]' \
    '(-na --approve --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command with -l]' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

_pi_auth() {
  local curcontext="$curcontext" context state state_descr line ret=1
  typeset -A opt_args
  local -a subcmds
  subcmds=(
    'print-api-key'
    'print-bearer-token'
    'check'
  )
  _arguments -S -C \
    '1: :->cmd' \
    '*:: :->args' && ret=0
  case $state in
    (cmd)
      _describe -t commands 'command' subcmds && ret=0
      ;;
    (args)
      curcontext="${curcontext%:*:*}:pi-auth-$line[1]:"
      case $line[1] in
        (print-api-key) _pi_auth_print_api_key && ret=0 ;;
        (print-bearer-token) _pi_auth_print_bearer_token && ret=0 ;;
        (check) _pi_auth_check && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

_pi_auth_print_api_key() {
  _arguments -S \
    '--provider[Auth commands require at least one of --provider or --model]:provider:_pi_providers' \
    '--model[Auth commands require at least one of --provider or --model]:model:_pi_models' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

_pi_auth_print_bearer_token() {
  _arguments -S \
    '--provider[Auth commands require at least one of --provider or --model]:provider:_pi_providers' \
    '--model[Auth commands require at least one of --provider or --model]:model:_pi_models' \
    '--min-expiry:duration:' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

_pi_auth_check() {
  _arguments -S \
    '--provider[Auth commands require at least one of --provider or --model]:provider:_pi_providers' \
    '--model[Auth commands require at least one of --provider or --model]:model:_pi_models' \
    '--json' \
    '--credentials[--credentials emits the credential, or includes it in JSON output]' \
    '--no-refresh[Checks refresh expired OAuth credentials by default; --no-refresh prevents this]' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

_pi_mcp() {
  local curcontext="$curcontext" context state state_descr line ret=1
  typeset -A opt_args
  local -a subcmds
  subcmds=(
    'add:Add or replace a server in mcp.json'
    'remove:Remove a server from mcp.json'
    'list:Show state, tools, and errors (exits 1 on failure)'
    'login:Sign in through the browser'
    'logout:Delete the stored OAuth credentials'
  )
  _arguments -S -C \
    '1: :->cmd' \
    '*:: :->args' && ret=0
  case $state in
    (cmd)
      _describe -t commands 'command' subcmds && ret=0
      ;;
    (args)
      curcontext="${curcontext%:*:*}:pi-mcp-$line[1]:"
      case $line[1] in
        (add) _pi_mcp_add && ret=0 ;;
        (remove) _pi_mcp_remove && ret=0 ;;
        (list) _pi_mcp_list && ret=0 ;;
        (login) _pi_mcp_login && ret=0 ;;
        (logout) _pi_mcp_logout && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

_pi_mcp_add() {
  local i=${words[(i)--]}
  if (( i < CURRENT )); then
    words=("${(@)words[i+1,-1]}")
    (( CURRENT -= i ))
    _normal
    return
  fi
  _arguments -S \
    '(-l --local)'{-l,--local}'[Use .pi/mcp.json in the current project instead of the global file]' \
    '--url[Streamable HTTP server URL (instead of a command)]:url:_urls' \
    '*--env[Environment variable for a stdio server (repeatable)]:KEY=VALUE:_parameters -qS=' \
    '--cwd[Working directory for a stdio server]:dir:_files -/' \
    '*--header[HTTP header (repeatable)]:KEY=VALUE:' \
    '--bearer-token-env-var[Send "Authorization\: Bearer ${NAME}"]:NAME:_parameters' \
    '--oauth-client-id[Pre-registered OAuth client id]:id:' \
    '--oauth-client-secret[OAuth client secret (may be ${NAME} or !command)]:secret:' \
    '--oauth-callback-port[Fixed OAuth callback port]:port:' \
    '--oauth-client-name[Client name sent when registering with the OAuth server]:name:' \
    '--exposure[codemode (default), deferred, direct, or hidden]:mode:(codemode deferred direct hidden)' \
    '--description[What the server offers, shown in the system prompt]:text:' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    ':server:' \
    '--[end of options, command follows]'
}

_pi_mcp_remove() {
  _arguments -S \
    '(-l --local)'{-l,--local}'[Use .pi/mcp.json in the current project instead of the global file]' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    ':server:_pi_mcp_servers'
}

_pi_mcp_list() {
  _arguments -S \
    '--json[Print the list as JSON]' \
    '(-h --help)'{-h,--help}'[Show this help]'
}

_pi_mcp_login() {
  _arguments -S \
    '--timeout[How long login waits for the browser (default\: 300)]:seconds:' \
    '(-h --help)'{-h,--help}'[Show this help]' \
    ':server:_pi_mcp_servers'
}

_pi_mcp_logout() {
  _arguments -S \
    '(-h --help)'{-h,--help}'[Show this help]' \
    ':server:_pi_mcp_servers'
}

compdef _pi pi
